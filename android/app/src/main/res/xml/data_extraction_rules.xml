<?xml version="1.0" encoding="utf-8"?>
<!-- Disable cloud backup and device-to-device transfer of app data (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
